# ─────────────────────────────────────────────────────────────
# SLEEP TALK — environment variables (copy to .env.local)
# Never commit real credentials.
# ─────────────────────────────────────────────────────────────

# Public base URL (used for emails, payment redirects, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database
#   Leave unset for local development: an embedded PostgreSQL (PGlite) is created in ./.data/pglite
#   and migrated + seeded with demo data automatically on first request.
#   Production: a real PostgreSQL connection string, e.g. postgres://user:pass@host:5432/sleeptalk
DATABASE_URL=
DATABASE_POOL_MAX=10
# Set to "false" to stop the embedded dev database from auto-seeding demo data.
SEED_DEMO_DATA=true

# First admin account created by the seed script.
# Required when seeding PostgreSQL. In local PGlite dev a documented default is used if unset.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Session cookie signing/hashing pepper (long random string in production)
AUTH_SECRET=replace-with-a-long-random-string

# Payments: Stripe Checkout only. Use sk_test_... keys locally (orders are flagged as test orders)
# and sk_live_... on the live store. Webhook endpoint: /api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email. Unset = emails are logged to the server console and ./.data/outbox.log
EMAIL_FROM="SLEEP TALK <no-reply@sleeptalk.example>"
RESEND_API_KEY=

# Optional analytics (loaded only after the visitor consents to analytics cookies)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Supabase Storage for product photos (production). Without a secret key, uploads are saved to
# public/uploads on local disk, which does not persist on serverless hosts such as Vercel.
NEXT_PUBLIC_SUPABASE_URL=
# Server-only secret key (sb_secret_...). Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Optional, defaults to "product-images" (created automatically as a public bucket).
SUPABASE_STORAGE_BUCKET=
